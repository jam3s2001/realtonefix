From d23ed47f95a62a7bb1155c8dd6ccb2a3e5a6b0d1 Mon Sep 17 00:00:00 2001
From: James <james@realtone.local>
Date: Thu, 5 Nov 2026 09:30:17 -0600
Subject: [PATCH] kernelbase, ksuser: KS filter and probe emulation for audio
 device interfaces

---
 dlls/kernelbase/file.c  | 707 ++++++++++++++++++++++++++++++++++++++++
 dlls/ksuser/Makefile.in |   1 +
 dlls/ksuser/ksuser.c    |  70 ++++
 dlls/ksuser/ksuser.spec |   2 +-
 dlls/mmdevapi/devenum.c | 266 +++++++++++++--
 dlls/ntdll/unix/file.c  |  11 +
 6 files changed, 1020 insertions(+), 37 deletions(-)
 create mode 100644 dlls/ksuser/ksuser.c

diff --git a/dlls/kernelbase/file.c b/dlls/kernelbase/file.c
index 6a821d7..36c8c9a 100644
--- a/dlls/kernelbase/file.c
+++ b/dlls/kernelbase/file.c
@@ -815,6 +815,38 @@ HANDLE WINAPI DECLSPEC_HOTPATCH CreateFileW( LPCWSTR filename, DWORD access, DWO
     };
 
 
+    /* Realtone diagnostic: KS device-interface paths (KSCATEGORY_* etc.)
+     * have no backing NT device in Wine yet; map them to the null device so
+     * presence probes by applications (e.g. Rocksmith 2014's cable scan)
+     * can proceed to their next stage instead of hard-failing. */
+    if (!wcsnicmp( filename, L"\\\\?\\", 4 ))
+    {
+        static const WCHAR *const ks_markers[] = {
+            L"{6994AD04-", L"{65E8773D-", L"{65E8773E-", L"{EB115FFC-",
+        };
+        const WCHAR *brace = wcschr( filename, L'{' );
+        DWORD i;
+        for (i = 0; brace && i < ARRAY_SIZE( ks_markers ); i++)
+            if (!wcsnicmp( brace, ks_markers[i], 10 ))
+            {
+                {
+                    void *caller = NULL, *caller2 = NULL;
+                    HMODULE mod = NULL;
+                    char modname[80] = "?";
+                    RtlCaptureStackBackTrace( 1, 2, &caller, NULL );
+                    RtlCaptureStackBackTrace( 2, 1, &caller2, NULL );
+                    if (caller && GetModuleHandleExW( GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                                                      GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                                                      (LPCWSTR)caller, &mod ) && mod)
+                        GetModuleFileNameA( mod, modname, sizeof(modname) );
+                    TRACE( "Realtone diagnostic: redirecting KS interface path to NUL caller=%p %s+0x%lx ret2=%p\n",
+                           caller, modname, (unsigned long)((const char *)caller - (const char *)mod), caller2 );
+                }
+                filename = L"\\\\.\\NUL";
+                break;
+            }
+    }
+
     /* sanity checks */
 
     if (!filename || !filename[0])
@@ -4358,6 +4390,184 @@ BOOL WINAPI DECLSPEC_HOTPATCH ClearCommError( HANDLE handle, DWORD *errors, COMS
 /****************************************************************************
  *	DeviceIoControl   (kernelbase.@)
  */
+/* Realtone diagnostic: per-pin context for the WaveRT pin emulation
+ * (the diagnostic runs inside the game process, so buffer addresses we
+ * hand out are directly usable by the application). */
+static HANDLE rtaudio_handles[8];
+static DWORD rtaudio_states[8];
+static ULONG rtaudio_sizes[8];
+static DWORD rtaudio_starts[8];
+static BYTE *rtaudio_bufs[8];
+static int rtaudio_handle_count;
+
+/* Realtone: bridge to winepulse's unix lib for real capture audio.
+ * Struct/func index MUST match dlls/mmdevapi/unixlib.h (ks_capture_ctl). */
+struct realtone_ks_params
+{
+    unsigned int cmd;       /* 0=start 1=read 2=stop 3=stats 4=pump */
+    unsigned int rate;
+    unsigned int channels;
+    void *buffer;
+    unsigned int bytes;
+    unsigned int used;
+    unsigned int total_lo;
+    unsigned int total_hi;
+    unsigned int status;
+};
+static unsigned long long realtone_pulse_handle;
+static NTSTATUS (WINAPI *realtone_unix_call)( unsigned long long, unsigned int, void * );
+static char realtone_ks_mode[8];          /* per rtaudio slot: 0 none, 1 packets, 2 poll */
+static unsigned long realtone_ks_served[8];
+
+static BOOL realtone_ks_call( struct realtone_ks_params *p )
+{
+    HMODULE mod;
+
+    if (!realtone_unix_call)
+    {
+        HMODULE ntdll = GetModuleHandleW( L"ntdll.dll" );
+        void *fn = ntdll ? GetProcAddress( ntdll, "__wine_unix_call_dispatcher" ) : NULL;
+        if (!fn || !*(void **)fn)
+        {
+            TRACE("Realtone: no unix call dispatcher\n");
+            return FALSE;
+        }
+        realtone_unix_call = *(NTSTATUS (WINAPI **)( unsigned long long, unsigned int, void * ))fn;
+    }
+    if (!realtone_pulse_handle)
+    {
+        unsigned long long h;
+        if (!(mod = LoadLibraryW( L"winepulse.drv" )))
+        {
+            TRACE("Realtone: winepulse.drv not loadable\n");
+            return FALSE;
+        }
+        if (NtQueryVirtualMemory( GetCurrentProcess(), mod, MemoryWineUnixFuncs,
+                                  &h, sizeof(h), NULL ))
+        {
+            TRACE("Realtone: no unix funcs on winepulse\n");
+            return FALSE;
+        }
+        realtone_pulse_handle = h;
+    }
+    realtone_unix_call( realtone_pulse_handle, 37 /* ks_capture_ctl */, p );
+    if (p->cmd != 1)
+        TRACE("Realtone: ks_call cmd=%u status=%u used=%u buf=%p bytes=%u totlo=%x\n",
+              p->cmd, p->status, p->used, p->buffer, p->bytes, p->total_lo);
+    return TRUE;
+}
+
+/* Start the capture (idempotent). The game opens its input at 44100 Hz mono
+ * 16-bit (audiodump-verified); PipeWire resamples the 48 kHz source. */
+static void realtone_ks_ensure_started(void)
+{
+    struct realtone_ks_params kp;
+    static int attempted;
+
+    if (attempted) return;
+    attempted = 1;
+    memset(&kp, 0, sizeof(kp));
+    kp.cmd = 0;
+    kp.rate = 44100;
+    kp.channels = 1;
+    if (realtone_ks_call(&kp))
+        TRACE("Realtone: ks capture start status=%u\n", kp.status);
+}
+
+static int realtone_slot_of(HANDLE h)
+{
+    int idx;
+    for (idx = 0; idx < 8; idx++)
+        if (rtaudio_handles[idx] == h) return idx;
+    for (idx = 0; idx < 8; idx++)
+        if (!rtaudio_handles[idx]) { rtaudio_handles[idx] = h; return idx; }
+    return 0;
+}
+
+/* Realtone: pending READ_STREAM queue. A real WaveCyclic capture pin PENDS
+ * each read until a packet is available; completing instantly raced the
+ * game's post->wait->process->repost protocol (it posted 4 packets, saw them
+ * all complete pre-wait, and shut its input thread down). We now queue the
+ * read and complete it from a pacing thread as the capture data arrives. */
+static struct
+{
+    OVERLAPPED *ov;
+    void *buf;
+    ULONG bytes;
+    int used;
+} realtone_pend[16];
+static RTL_CRITICAL_SECTION realtone_pend_cs;
+static int realtone_pend_cs_init;
+static HANDLE realtone_pacer_thread;
+
+static DWORD WINAPI realtone_pacer(void *arg)
+{
+    for (;;)
+    {
+        int i, target = -1;
+        OVERLAPPED *ov;
+        void *buf;
+        ULONG bytes;
+        struct realtone_ks_params kp;
+
+        RtlEnterCriticalSection( &realtone_pend_cs );
+        for (i = 0; i < 16; i++)
+            if (realtone_pend[i].used) { target = i; break; }
+        if (target >= 0)
+        {
+            ov = realtone_pend[target].ov;
+            buf = realtone_pend[target].buf;
+            bytes = realtone_pend[target].bytes;
+            realtone_pend[target].used = 0;
+        }
+        RtlLeaveCriticalSection( &realtone_pend_cs );
+        if (target < 0) { Sleep( 5 ); continue; }
+
+        realtone_ks_ensure_started();
+        memset( &kp, 0, sizeof(kp) );
+        kp.cmd = 1;
+        kp.buffer = buf;
+        kp.bytes = bytes;
+        if (!realtone_ks_call( &kp ) || kp.status)
+            memset( buf, 0, bytes );
+        ov->Internal = 0;               /* STATUS_SUCCESS */
+        ov->InternalHigh = bytes;
+        if (ov->hEvent) SetEvent( ov->hEvent );
+    }
+    return 0;
+}
+
+static BOOL realtone_queue_read( OVERLAPPED *ov, void *buf, ULONG bytes )
+{
+    int i;
+    if (!realtone_pend_cs_init)
+    {
+        static LONG once;
+        if (InterlockedCompareExchange( &once, 1, 0 ) == 0)
+        {
+            int j;
+            for (j = 0; j < 16; j++) realtone_pend[j].used = 0;
+            RtlInitializeCriticalSection( &realtone_pend_cs );
+            realtone_pend_cs_init = 1;
+            realtone_pacer_thread = CreateThread( NULL, 0, realtone_pacer, NULL, 0, NULL );
+        }
+    }
+    if (!realtone_pacer_thread) return FALSE;
+    RtlEnterCriticalSection( &realtone_pend_cs );
+    for (i = 0; i < 16; i++)
+        if (!realtone_pend[i].used)
+        {
+            realtone_pend[i].ov = ov;
+            realtone_pend[i].buf = buf;
+            realtone_pend[i].bytes = bytes;
+            realtone_pend[i].used = 1;
+            RtlLeaveCriticalSection( &realtone_pend_cs );
+            return TRUE;
+        }
+    RtlLeaveCriticalSection( &realtone_pend_cs );
+    return FALSE;
+}
+
 BOOL WINAPI DECLSPEC_HOTPATCH DeviceIoControl( HANDLE handle, DWORD code, void *in_buff, DWORD in_count,
                                                void *out_buff, DWORD out_count, DWORD *returned,
                                                OVERLAPPED *overlapped )
@@ -4369,6 +4579,503 @@ BOOL WINAPI DECLSPEC_HOTPATCH DeviceIoControl( HANDLE handle, DWORD code, void *
 
     TRACE( "(%p,%lx,%p,%ld,%p,%ld,%p,%p)\n",
            handle, code, in_buff, in_count, out_buff, out_count, returned, overlapped );
+    /* Realtone diagnostic: KS stream I/O (IOCTL_KS_READ_STREAM /
+     * IOCTL_KS_WRITE_STREAM) for the WaveCyclic capture path the game's
+     * vendored PortAudio uses. Completes each packet synchronously with
+     * silence and signals the caller's event, so the capture loop runs. */
+    if ((code == 0x2f4017 || code == 0x2f4013) && out_buff && out_count >= 48)
+    {
+        /* Classic 32-bit KSSTREAM_HEADER (Size=0x30, live-dump verified):
+         * +0 Size, +4 TypeSpecificFlags, +8 PresentationTime(16), +0x18
+         * Duration, +0x20 FrameExtent, +0x24 DataUsed, +0x28 Data,
+         * +0x2C OptionsFlags. The game passes one 48-byte header/call. */
+        ULONG *frameExtent32 = (ULONG *)((char *)out_buff + 0x20);
+        ULONG *dataUsed32 = (ULONG *)((char *)out_buff + 0x24);
+        void **data = (void **)((char *)out_buff + 0x28);
+        ULONG frameExtent = *frameExtent32;
+
+        if (code == 0x2f4017 && *data && frameExtent)
+        {
+            /* capture: serve REAL audio from the cable's PipeWire source via
+             * winepulse; silence-padded on starvation; silence on bridge failure */
+            struct realtone_ks_params kp;
+            int slot = realtone_slot_of(handle);
+            realtone_ks_ensure_started();
+            memset(&kp, 0, sizeof(kp));
+            kp.cmd = 1;
+            kp.buffer = *data;
+            kp.bytes = frameExtent;
+            if (!realtone_ks_call(&kp) || kp.status)
+                memset(*data, 0, frameExtent);
+            else
+            {
+                realtone_ks_mode[slot] = 1;
+                realtone_ks_served[slot] += frameExtent;
+                if ((realtone_ks_served[slot] & 0xffff) < frameExtent)
+                {
+                    /* frequent health line: peak amplitude of this packet */
+                    int i, peak = 0;
+                    const short *s = (const short *)*data;
+                    for (i = 0; i < (int)(frameExtent / 2) && i < 4096; i++)
+                    {
+                        int v = s[i] < 0 ? -(int)s[i] : (int)s[i];
+                        if (v > peak) peak = v;
+                    }
+                    TRACE("Realtone: KS read pkt bytes=%lu used=%u peak=%d served=%lu\n",
+                          (unsigned long)frameExtent, kp.used, peak,
+                          realtone_ks_served[slot]);
+                }
+            }
+        }
+        if (frameExtent)
+            *dataUsed32 = frameExtent;
+        if (overlapped && code == 0x2f4017 && *data && frameExtent)
+        {
+            /* real WaveCyclic semantics: the read PENDS until a packet is
+             * available; the pacing thread completes it with capture data */
+            if (realtone_queue_read( overlapped, *data, frameExtent ))
+            {
+                SetLastError( ERROR_IO_PENDING );
+                return FALSE;
+            }
+            /* queue full: fall through to synchronous completion */
+        }
+        if (overlapped)
+        {
+            overlapped->Internal = 0;               /* STATUS_SUCCESS */
+            overlapped->InternalHigh = frameExtent;
+            if (overlapped->hEvent)
+                SetEvent(overlapped->hEvent);
+        }
+        TRACE("Realtone diagnostic: KS stream %s %lu bytes\n",
+              code == 0x2f4017 ? "read" : "write", (unsigned long)frameExtent);
+        SetLastError(0);
+        return TRUE;
+    }
+
+    /* Realtone diagnostic: emulate a minimal KS capture filter so the
+     * game's scan can proceed. Sets observed from Rocksmith 2014:
+     * KSPROPSETID_Pin {8C134960-51AD-11CF-878A-94F801C10000},
+     * KSPROPSETID_General {720D4AC0-7533-11D0-A5D6-28DB04C10000},
+     * KSPROPSETID_Topology {1464EDA5-6A8F-11D1-9AA7-00A0C9223196}. */
+    if (code == 0x2f0003 && in_buff && in_count >= 8) /* Realtone diag: log all sizes */
+    {
+        const DWORD *kp = in_buff; /* KSPROPERTY: Set[4], Id, Flags */
+        DWORD set0 = kp[0];
+        DWORD id = 0, flags = 0, pinid = 0;
+
+        if (in_count >= 24) { id = kp[4]; flags = kp[5]; }
+        if (in_count >= 28) pinid = kp[6];
+
+        {
+            void *caller = NULL, *caller2 = NULL;
+            DWORD frames = RtlCaptureStackBackTrace( 1, 2, &caller, (DWORD *)&caller2 );
+            HMODULE mod = NULL;
+            char modname[64] = "?";
+            if (frames && GetModuleHandleExW( GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                                              GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                                              (LPCWSTR)caller, &mod ) && mod)
+                GetModuleFileNameA( mod, modname, sizeof(modname) );
+            TRACE( "Realtone diagnostic: KS probe set=%08x id=%u flags=%u pin=%u in=%u out=%u caller=%p caller2=%p %s+0x%lx\n",
+                   (unsigned)set0, (unsigned)id, (unsigned)flags, (unsigned)pinid,
+                   (unsigned)in_count, (unsigned)out_count, caller, caller2, modname,
+                   (unsigned long)((const char *)caller - (const char *)mod) );
+            if (caller2 && !((ULONG_PTR)caller2 & 1))
+            {
+                /* the packer re-encrypts code pages after use; the caller's
+                 * page is only readable DURING this call — dump the bytes */
+                const unsigned char *cp = (const unsigned char *)caller2 - 0x20;
+                TRACE( "Realtone: caller2 bytes-20: %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x | %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x\n",
+                       cp[0],cp[1],cp[2],cp[3],cp[4],cp[5],cp[6],cp[7],cp[8],cp[9],cp[10],cp[11],cp[12],cp[13],cp[14],cp[15],
+                       cp[16],cp[17],cp[18],cp[19],cp[20],cp[21],cp[22],cp[23],cp[24],cp[25],cp[26],cp[27],cp[28],cp[29],cp[30],cp[31]);
+            }
+        }
+
+        /* Realtone diagnostic: WaveRT pin emulation (KSPROPSETID_RtAudio
+         * {1D58C920-AC9B-11CF-8E5D-0020AF0B7EC9}), pin connection state
+         * (KSPROPSETID_Connection {6A174AC0-...}) and stream position
+         * (KSPROPSETID_Audio {1155A920-...}). PortAudio's WDM-KS backend
+         * (vendored in Rocksmith 2014) needs these on the instantiated pin
+         * to finish opening a capture stream. */
+        if (set0 == 0x1d58c920)
+        {
+            int idx;
+
+            for (idx = 0; idx < 8; idx++)
+                if (rtaudio_handles[idx] == handle) break;
+            if (idx == 8 && rtaudio_handle_count < 8)
+            {
+                idx = realtone_slot_of(handle);
+                rtaudio_handle_count = max(rtaudio_handle_count, idx + 1);
+                rtaudio_handles[idx] = handle;
+                rtaudio_states[idx] = 0;
+                rtaudio_sizes[idx] = 0;
+                rtaudio_bufs[idx] = NULL;
+            }
+            if (idx < 8 && id == 0 && (flags & 0xfffffff9) == 0x00000001 && in_count >= 32)
+            {
+                /* KSPROPERTY_RTAUDIO_BUFFER: hand out a real cyclic buffer */
+                ULONG requested = *(const DWORD *)((const char *)in_buff + 28);
+                if (!rtaudio_bufs[idx])
+                {
+                    rtaudio_bufs[idx] = VirtualAlloc(NULL, 0x200000, MEM_COMMIT, PAGE_READWRITE);
+                    rtaudio_starts[idx] = GetTickCount();
+                }
+                if (!rtaudio_bufs[idx])
+                {
+                    SetLastError(ERROR_OUTOFMEMORY);
+                    return FALSE;
+                }
+                rtaudio_sizes[idx] = requested && requested < 0x200000 ? requested : 0x200000;
+                if (out_buff && out_count >= 12)
+                {
+                    *(DWORD *)out_buff = (DWORD)(UINT_PTR)rtaudio_bufs[idx];
+                    *(DWORD *)((char *)out_buff + 4) = rtaudio_sizes[idx];
+                    *(DWORD *)((char *)out_buff + 8) = 0; /* CallMemoryBarrier */
+                    if (returned) *returned = 12;
+                    TRACE("Realtone diagnostic: RTAUDIO_BUFFER -> buf=%p size=%lu\n",
+                          rtaudio_bufs[idx], (unsigned long)rtaudio_sizes[idx]);
+                    SetLastError(0);
+                    return TRUE;
+                }
+                TRACE("Realtone diagnostic: RTAUDIO_BUFFER -> MORE_DATA need=12\n");
+                SetLastError(ERROR_MORE_DATA);
+                if (returned) *returned = 12;
+                return FALSE;
+            }
+            if (idx < 8 && id == 0 && flags == 0x00000003)
+            {
+                /* BASICSUPPORT for RTAUDIO_BUFFER: GET|SET access flags */
+                if (out_buff && out_count >= 4)
+                {
+                    *(DWORD *)out_buff = 0x00000003;
+                    if (returned) *returned = 4;
+                    TRACE("Realtone diagnostic: RTAUDIO BUFFER basicsupport -> 0x3\n");
+                    SetLastError(0);
+                    return TRUE;
+                }
+                SetLastError(ERROR_MORE_DATA);
+                if (returned) *returned = 4;
+                return FALSE;
+            }
+            if (idx < 8 && id == 0 && (flags & 0x00000002))
+            {
+                /* SET of RTAUDIO_BUFFER: succeed (buffer already mapped) */
+                TRACE("Realtone diagnostic: RTAUDIO BUFFER set (no-op)\n");
+                SetLastError(0);
+                if (returned) *returned = 0;
+                return TRUE;
+            }
+            if (idx < 8 && id == 3 && (flags & 0x00000001))
+            {
+                /* KSPROPERTY_RTAUDIO_BUFFER_WITH_NOTIFICATION GET:
+                 * KSRTAUDIO_BUFFER_WITH_NOTIFICATION (32-bit):
+                 * {PVOID BufferAddress, ULONG ActualSize, ULONG CallMemoryBarrier,
+                 *  ULONG NotificationCount, HANDLE NotificationEvent} = 20 bytes.
+                 * Hand out a real cyclic buffer + our event; winepulse's pulse
+                 * read callback fills the buffer and signals the event. */
+                static const ULONG notif_size = 0x10000; /* 64 KiB (~743 ms @44.1k mono16) */
+                if (out_buff && out_count >= 20)
+                {
+                    BYTE *buf = VirtualAlloc(NULL, notif_size, MEM_COMMIT, PAGE_READWRITE);
+                    HANDLE ev;
+                    struct realtone_ks_params kp;
+
+                    if (!buf)
+                    {
+                        SetLastError(ERROR_OUTOFMEMORY);
+                        return FALSE;
+                    }
+                    memset(buf, 0, notif_size);
+                    ev = CreateEventW(NULL, FALSE, FALSE, NULL);
+                    if (!ev)
+                    {
+                        VirtualFree(buf, 0, MEM_RELEASE);
+                        SetLastError(ERROR_OUTOFMEMORY);
+                        return FALSE;
+                    }
+                    *(void **)out_buff = buf;
+                    *(ULONG *)((char *)out_buff + 4) = notif_size;
+                    *(ULONG *)((char *)out_buff + 8) = 0; /* CallMemoryBarrier */
+                    *(ULONG *)((char *)out_buff + 12) = 8; /* NotificationCount */
+                    *(HANDLE *)((char *)out_buff + 16) = ev;
+                    if (returned) *returned = 20;
+                    memset(&kp, 0, sizeof(kp));
+                    kp.cmd = 5;
+                    kp.buffer = buf;
+                    kp.bytes = notif_size;
+                    /* event HANDLE + stride ride in rate/channels: these fields
+                     * are moved by the wow64 thunk's scalar path, which is
+                     * proven reliable (the xmm-copied used/total_lo fields
+                     * arrive zeroed through the wow64 unix-call layer). */
+                    kp.rate = (unsigned int)(UINT_PTR)ev;  /* HANDLE */
+                    kp.channels = notif_size / 8;          /* stride */
+                    realtone_ks_call(&kp);
+                    rtaudio_bufs[idx] = buf;
+                    rtaudio_sizes[idx] = notif_size;
+                    rtaudio_starts[idx] = GetTickCount();
+                    realtone_ks_mode[idx] = 2;
+                    realtone_ks_ensure_started();
+                    TRACE("Realtone diagnostic: RTAUDIO BUFFER_WITH_NOTIFICATION -> buf=%p size=%lx ev=%p\n",
+                          buf, (unsigned long)notif_size, ev);
+                    SetLastError(0);
+                    return TRUE;
+                }
+                SetLastError(ERROR_MORE_DATA);
+                if (returned) *returned = 20;
+                return FALSE;
+            }
+            if (idx < 8 && (id == 6 || id == 7) && (flags & 0x00000002))
+            {
+                /* notification/wake event registration SET: accepted */
+                TRACE("Realtone diagnostic: RTAUDIO notif event SET id=%lu accepted\n", (unsigned long)id);
+                SetLastError(0);
+                if (returned) *returned = 0;
+                return TRUE;
+            }
+            /* id 1 (position register): fail -> PortAudio falls back to
+             * polled position via KSPROPERTY_AUDIO_POSITION (by design). */
+        }
+        else if (set0 == 0x6a174ac0 && id == 2)
+        {
+            /* KSPROPERTY_CONNECTION_STATE */
+            int idx = realtone_slot_of(handle);
+
+            if ((flags & 0xfffffff9) == 0x00000001) /* GET */
+            {
+                if (out_buff && out_count >= 4)
+                {
+                    *(DWORD *)out_buff = rtaudio_states[idx];
+                    if (returned) *returned = 4;
+                    TRACE("Realtone diagnostic: CONNECTION_STATE -> %lu\n", (unsigned long)rtaudio_states[idx]);
+                    SetLastError(0);
+                    return TRUE;
+                }
+                SetLastError(ERROR_MORE_DATA);
+                if (returned) *returned = 4;
+                return FALSE;
+            }
+            if (in_count >= 28)
+            {
+                rtaudio_states[idx] = *(const DWORD *)((const char *)in_buff + 24);
+                TRACE("Realtone diagnostic: CONNECTION_STATE set to %lu\n", (unsigned long)rtaudio_states[idx]);
+                if (rtaudio_states[idx] == 3) /* KSSTATE_RUN: the pin is live */
+                    realtone_ks_ensure_started();
+                SetLastError(0);
+                if (returned) *returned = 0;
+                return TRUE;
+            }
+        }
+        else if (set0 == 0x1155a920)
