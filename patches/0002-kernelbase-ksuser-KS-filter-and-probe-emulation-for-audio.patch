+/* KSPIN_CONNECT layout (ks.h): Interface (GUID+Id+Flags), Medium (GUID+Id+Flags),
+ * PinId, PinToHandle, Priority (Class+SubClass). Only PinId is needed here. */
+typedef struct
+{
+    GUID Set;
+    ULONG Id;
+    ULONG Flags;
+    GUID MediumSet;
+    ULONG MediumId;
+    ULONG MediumFlags;
+    ULONG PinId;
+    HANDLE PinToHandle;
+    ULONG PriorityClass;
+    ULONG PrioritySubClass;
+} KSPIN_CONNECT;
+
+/***********************************************************************
+ *              KsCreatePin (ksuser.@)
+ *
+ * Creates a pin instance on a KS filter. On Windows this is an
+ * NtCreateFile with the KSPIN_CONNECT as the EA buffer, dispatched by
+ * the filter's driver. Until Wine's audio device interfaces are backed
+ * by a real KS driver, a pin handle is represented by duplicating the
+ * filter handle; property/stream IOCTLs on it are answered by the same
+ * handler that serves the filter.
+ */
+DWORD WINAPI KsCreatePin( HANDLE filter, const KSPIN_CONNECT *connect,
+                          ACCESS_MASK access, HANDLE *connection )
+{
+    TRACE( "filter %p, connect %p (pin id %lu, access 0x%08lx), connection %p\n",
+           filter, connect, connect ? (ULONG)connect->PinId : 0, (ULONG)access, connection );
+
+    if (!connection) return ERROR_INVALID_PARAMETER;
+    if (!filter) return ERROR_INVALID_HANDLE;
+    if (!connect) return ERROR_INVALID_PARAMETER;
+
+    if (!DuplicateHandle( GetCurrentProcess(), filter, GetCurrentProcess(),
+                          connection, 0, FALSE, DUPLICATE_SAME_ACCESS ))
+        return GetLastError();
+
+    return ERROR_SUCCESS;
+}
