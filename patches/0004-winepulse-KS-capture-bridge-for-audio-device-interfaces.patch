+static void pulse_probe_settings(int render, const char *pulse_name, WAVEFORMATEXTENSIBLE *fmt, REFERENCE_TIME *def_period, REFERENCE_TIME *min_period);
+
+/* Fill in a sane default format for a device that hasn't been probed yet.
+ * Mirrors what pulse_probe_settings ends up with when its probe stream
+ * fails. Devices discovered through hotplug refreshes rely on this. */
+static void pulse_set_default_format(PhysDevice *dev)
+{
+    pa_channel_map map;
+    pa_sample_spec ss;
+    unsigned int length;
+
+    pa_channel_map_init_auto(&map, 2, PA_CHANNEL_MAP_ALSA);
+    ss.rate = 48000;
+    ss.format = PA_SAMPLE_FLOAT32LE;
+    ss.channels = map.channels;
+    length = pa_frame_size(&ss);
+
+    dev->fmt.Format.wFormatTag = WAVE_FORMAT_EXTENSIBLE;
+    dev->fmt.Format.nChannels = 2;
+    dev->fmt.Format.nSamplesPerSec = 48000;
+    dev->fmt.Format.wBitsPerSample = 32;
+    dev->fmt.Format.nBlockAlign = 8;
+    dev->fmt.Format.nAvgBytesPerSec = 48000 * 8;
+    dev->fmt.Format.cbSize = sizeof(WAVEFORMATEXTENSIBLE) - sizeof(WAVEFORMATEX);
+    dev->fmt.Samples.wValidBitsPerSample = 32;
+    dev->fmt.dwChannelMask = SPEAKER_FRONT_LEFT | SPEAKER_FRONT_RIGHT;
+    dev->fmt.SubFormat = KSDATAFORMAT_SUBTYPE_IEEE_FLOAT;
+    dev->def_period = dev->min_period = pa_bytes_to_usec(10 * length, &ss);
+}
+
+/* Rebuild the physical device lists from the server. When block is set the
+ * pending info operations are iterated to completion and the formats are
+ * probed synchronously (startup path, no mainloop thread yet). When block
+ * is zero the operations are merely issued; their callbacks fill in the
+ * lists as the mainloop thread dispatches them (hotplug path). */
+static void pulse_refresh_device_lists(pa_context *ctx, int block)
+{
+    PhysDevice *dev;
+    pa_operation *o;
+    int ret;
+
+    free_phys_device_lists();
+    list_init(&g_phys_speakers);
+    list_init(&g_phys_sources);
+
+    /* Burnout Paradise Remastered expects device name to have a space. */
+    pulse_add_device(&g_phys_speakers, NULL, 0, Speakers, 0, "", "PulseAudio Output");
+    pulse_add_device(&g_phys_sources, NULL, 0, Microphone, 0, "", "PulseAudio Input");
+
+    o = pa_context_get_sink_info_list(ctx, &pulse_phys_speakers_cb, NULL);
+    if (o) {
+        while (block && pa_mainloop_iterate(pulse_ml, 1, &ret) >= 0 &&
+                pa_operation_get_state(o) == PA_OPERATION_RUNNING)
+        {}
+        pa_operation_unref(o);
+    }
+
+    o = pa_context_get_source_info_list(ctx, &pulse_phys_sources_cb, NULL);
+    if (o) {
+        while (block && pa_mainloop_iterate(pulse_ml, 1, &ret) >= 0 &&
+                pa_operation_get_state(o) == PA_OPERATION_RUNNING)
+        {}
+        pa_operation_unref(o);
+    }
+
+    if (block) {
+        LIST_FOR_EACH_ENTRY(dev, &g_phys_speakers, PhysDevice, entry) {
+            pulse_probe_settings(1, dev->pulse_name, &dev->fmt, &dev->def_period, &dev->min_period);
+        }
+
+        LIST_FOR_EACH_ENTRY(dev, &g_phys_sources, PhysDevice, entry) {
+            pulse_probe_settings(0, dev->pulse_name, &dev->fmt, &dev->def_period, &dev->min_period);
+        }
+    }
+}
+
+static void pulse_subscribe_cb(pa_context *c, pa_subscription_event_type_t t, uint32_t idx, void *userdata)
+{
+    pa_subscription_event_type_t facility = t & PA_SUBSCRIPTION_EVENT_FACILITY_MASK;
+    pa_subscription_event_type_t type = t & PA_SUBSCRIPTION_EVENT_TYPE_MASK;
+
+    if ((facility == PA_SUBSCRIPTION_EVENT_SINK || facility == PA_SUBSCRIPTION_EVENT_SOURCE) &&
+        (type == PA_SUBSCRIPTION_EVENT_NEW || type == PA_SUBSCRIPTION_EVENT_REMOVE))
+    {
+        TRACE("Pulse server device list changed, refreshing endpoints\n");
+        pulse_refresh_device_lists(c, 0);
+    }
+}
