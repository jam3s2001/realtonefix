+
+/* ================= Realtone: KS capture bridge =================
+ * Serves the game's emulated WDM-KS capture pin (kernelbase
+ * DeviceIoControl) from the Realtone cable's real PulseAudio source.
+ * One record stream feeds a ring; consumers are either packet reads
+ * (IOCTL_KS_READ_STREAM) or poll-mode pumps (cyclic buffer + position). */
+
+#define KS_CAP_RING_BYTES 0x40000
+static pa_stream *ks_cap_stream;
+static BYTE *ks_cap_ring;
+static ULONGLONG ks_cap_total;   /* bytes captured into the ring (monotonic) */
+static ULONGLONG ks_cap_fill;    /* bytes currently readable in the ring */
+static ULONGLONG ks_cap_pumped;  /* bytes delivered to poll-mode buffers (monotonic) */
+static unsigned int ks_cap_rate, ks_cap_channels;
+/* WaveRT-with-notification bridge state (set by cmd=5 from kernelbase):
+ * the game's cyclic buffer + KS notification event are filled/signalled
+ * from the pulse read callback, so pacing works without game polling. */
+static BYTE *ks_notif_buf;
+static unsigned int ks_notif_size, ks_notif_stride;
+static unsigned long long ks_notif_event;   /* HANDLE of the game's event */
+static ULONGLONG ks_notif_last;             /* total at last event signal */
+static unsigned int ks_notif_pending;       /* events armed via cmd=5 */
+
+static BOOL ks_cap_name_has(const char *haystack, const char *needle)
+{
+    char h[256], n[32];
+    unsigned int i;
+    if (!haystack) return FALSE;
+    for (i = 0; haystack[i] && i < sizeof(h) - 1; i++)
+        h[i] = tolower((unsigned char)haystack[i]);
+    h[i] = 0;
+    for (i = 0; needle[i] && i < sizeof(n) - 1; i++)
+        n[i] = tolower((unsigned char)needle[i]);
+    n[i] = 0;
+    return strstr(h, n) != NULL;
+}
+
+/* runs on the pulse mainloop thread (pulse_mutex held by the loop) */
+static void ks_cap_read_cb(pa_stream *s, size_t length, void *userdata)
+{
+    const void *data;
+    SIZE_T n, wp, tail;
+
+    if (!ks_cap_ring || !length)
+        return;
+    if (pa_stream_peek(s, &data, &length) < 0)
+        return;
+    if (data && length)
+    {
+        n = min((SIZE_T)length, (SIZE_T)KS_CAP_RING_BYTES - ks_cap_fill);
+        wp = ks_cap_total % KS_CAP_RING_BYTES;
+        tail = min(n, (SIZE_T)KS_CAP_RING_BYTES - wp);
+        memcpy(ks_cap_ring + wp, data, tail);
+        if (n > tail)
+            memcpy(ks_cap_ring, (const BYTE *)data + tail, n - tail);
+        ks_cap_total += n;
+        ks_cap_fill += n;
+        if (n < length)
+            WARN("ks capture ring overflow, dropped %lu bytes\n", (unsigned long)(length - n));
+        if (ks_notif_buf && ks_notif_size)
+        {
+            /* drain the fresh chunk straight into the game's cyclic buffer.
+             * Use the FULL chunk (length), not the ring-limited n: the ring
+             * is packet-mode only; starving the pump here would freeze the
+             * notification cadence once the ring fills. */
+            SIZE_T m = min((SIZE_T)length, (SIZE_T)ks_notif_size), w, t2;
+            const BYTE *src = (const BYTE *)data;
+            SIZE_T done = 0;
+            while (done < m)
+            {
+                w = ks_cap_pumped % ks_notif_size;
+                t2 = min(m - done, ks_notif_size - w);
+                memcpy(ks_notif_buf + w, src + done, t2);
+                ks_cap_pumped += t2;
+                done += t2;
+            }
+            if (ks_notif_event && ks_notif_stride &&
+                ks_cap_pumped - ks_notif_last >= ks_notif_stride)
+            {
+                ks_notif_last = ks_cap_pumped;
+                NtSetEvent((void *)(UINT_PTR)ks_notif_event, NULL);
+            }
+        }
+    }
+    pa_stream_drop(s);
+}
+
+static SIZE_T ks_cap_copy_out(BYTE *dst, SIZE_T bytes)
+{
+    SIZE_T done = 0;
+    while (done < bytes && ks_cap_fill)
+    {
+        SIZE_T rp = (ks_cap_total - ks_cap_fill) % KS_CAP_RING_BYTES;
+        SIZE_T n = min(min(ks_cap_fill, bytes - done), (SIZE_T)KS_CAP_RING_BYTES - rp);
+        memcpy(dst + done, ks_cap_ring + rp, n);
+        ks_cap_fill -= n;
+        done += n;
+    }
+    return done;
+}
+
+static NTSTATUS pulse_ks_capture_ctl(void *args)
+{
+    struct ks_capture_params *p = args;
+
+    p->status = 0;
+    p->used = 0;
+    p->total_lo = 0;
+    p->total_hi = 0;
+
+    if (p->cmd == 0)
+    {
+        const char *source = NULL;
+        pa_sample_spec ss;
+        pa_buffer_attr attr;
+        PhysDevice *dev;
+
+        pulse_lock();
+        if (ks_cap_stream && ks_cap_rate == p->rate && ks_cap_channels == p->channels)
+        {
+            pulse_unlock();
+            return STATUS_SUCCESS;
+        }
+        if (!pulse_ctx || pa_context_get_state(pulse_ctx) != PA_CONTEXT_READY)
+        {
+            pulse_unlock();
+            p->status = 2;
+            return STATUS_SUCCESS;
+        }
+        if (ks_cap_stream)
+        {
+            pa_stream_disconnect(ks_cap_stream);
+            pa_stream_unref(ks_cap_stream);
+            ks_cap_stream = NULL;
+        }
+        /* prefer the exact VID/PID of the Realtone cable */
+        LIST_FOR_EACH_ENTRY(dev, &g_phys_sources, PhysDevice, entry)
+        {
+            if (dev->vendor_id == 0x12ba && dev->product_id == 0x00ff)
+            {
+                source = dev->pulse_name;
+                break;
+            }
+        }
+        if (!source)
+        {
+            LIST_FOR_EACH_ENTRY(dev, &g_phys_sources, PhysDevice, entry)
+            {
+                if (ks_cap_name_has(dev->pulse_name, "rocksmith"))
+                {
+                    source = dev->pulse_name;
+                    break;
+                }
+            }
+        }
+        if (!source)
+        {
+            pulse_unlock();
+            p->status = 1;
+            WARN("ks capture: no Rocksmith source in %u devices\n", list_count(&g_phys_sources));
+            return STATUS_SUCCESS;
+        }
+        ss.format = PA_SAMPLE_S16LE;
+        ss.rate = p->rate;
+        ss.channels = p->channels;
+        attr.maxlength = (uint32_t)-1;
+        attr.tlength = (uint32_t)-1;
+        attr.prebuf = (uint32_t)-1;
+        attr.minreq = (uint32_t)-1;
+        attr.fragsize = pa_usec_to_bytes(10 * PA_USEC_PER_MSEC, &ss);
+        if (!ks_cap_ring)
+            ks_cap_ring = malloc(KS_CAP_RING_BYTES);
+        if (!ks_cap_ring)
+        {
+            pulse_unlock();
+            p->status = 3;
+            return STATUS_SUCCESS;
+        }
+        ks_cap_total = ks_cap_fill = ks_cap_pumped = 0;
+        ks_cap_stream = pa_stream_new(pulse_ctx, "wine-ks-capture", &ss, NULL);
+        if (ks_cap_stream)
+        {
+            pa_stream_set_read_callback(ks_cap_stream, ks_cap_read_cb, NULL);
+            if (pa_stream_connect_record(ks_cap_stream, source, &attr, PA_STREAM_ADJUST_LATENCY) >= 0)
+            {
+                ks_cap_rate = p->rate;
+                ks_cap_channels = p->channels;
+                pulse_unlock();
+                TRACE("ks capture started: source %s rate %u ch %u fragsize %u\n",
+                      source, p->rate, p->channels, attr.fragsize);
+                return STATUS_SUCCESS;
+            }
+            pa_stream_unref(ks_cap_stream);
+            ks_cap_stream = NULL;
+        }
+        pulse_unlock();
+        p->status = 1;
+        WARN("ks capture: connect_record failed for %s\n", source);
+        return STATUS_SUCCESS;
+    }
+
+    if (p->cmd == 1) /* packet read: wait briefly for real data, pad on starvation */
+    {
+        SIZE_T done = 0;
+        unsigned int waited = 0;
+        while (done < p->bytes)
+        {
+            pulse_lock();
+            done += ks_cap_copy_out((BYTE *)p->buffer + done, p->bytes - done);
+            pulse_unlock();
+            if (done >= p->bytes || waited >= 200)
+                break;
+            usleep(2000);
+            waited += 2;
+        }
+        if (done < p->bytes)
+            memset((BYTE *)p->buffer + done, 0, p->bytes - done);
+        p->used = done;
+        return STATUS_SUCCESS;
+    }
+
+    if (p->cmd == 2) /* stop */
+    {
+        pulse_lock();
+        ks_notif_buf = NULL;
+        ks_notif_size = 0;
+        ks_notif_event = 0;
+        ks_notif_pending = 0;
+        if (ks_cap_stream)
+        {
+            pa_stream_disconnect(ks_cap_stream);
+            pa_stream_unref(ks_cap_stream);
+            ks_cap_stream = NULL;
+        }
+        pulse_unlock();
+        return STATUS_SUCCESS;
+    }
+
+    if (p->cmd == 3) /* stats */
+    {
+        pulse_lock();
+        p->total_lo = (unsigned int)ks_cap_total;
+        p->total_hi = (unsigned int)(ks_cap_total >> 32);
+        p->used = (unsigned int)ks_cap_fill;
+        pulse_unlock();
+        return STATUS_SUCCESS;
+    }
+
+    if (p->cmd == 4) /* poll-mode pump into the caller's cyclic buffer */
+    {
+        BYTE *dst = p->buffer;
+        SIZE_T size = p->bytes, chunk;
+        if (!dst || !size)
+            return STATUS_SUCCESS;
+        pulse_lock();
