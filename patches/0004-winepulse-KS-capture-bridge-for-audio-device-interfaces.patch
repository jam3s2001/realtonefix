diff --git a/dlls/mmdevapi/unixlib.h b/dlls/mmdevapi/unixlib.h
index 3df13e9..0e60087 100644
--- a/dlls/mmdevapi/unixlib.h
+++ b/dlls/mmdevapi/unixlib.h
@@ -350,5 +350,23 @@ enum unix_funcs
     midi_in_message,
     midi_notify_wait,
     aux_message,
+    ks_capture_ctl,
     funcs_count
 };
+
+/* Realtone project: KS capture bridge. The game's WDM-KS capture pin is
+ * emulated in kernelbase DeviceIoControl; this call funnels its audio
+ * requests to the real PulseAudio/PipeWire source of the Realtone cable
+ * (the only audio backend already connected in-process). */
+struct ks_capture_params
+{
+    unsigned int cmd;       /* 0=start 1=read 2=stop 3=stats 4=pump */
+    unsigned int rate;      /* in:  requested rate (start) */
+    unsigned int channels;  /* in:  requested channels (start) */
+    void *buffer;           /* in:  dest (read) / cyclic buffer (pump) */
+    unsigned int bytes;     /* in:  request size; out: bytes moved */
+    unsigned int used;      /* out: real bytes moved (rest zero-padded) */
+    unsigned int total_lo;  /* out: total bytes (lo/hi split: 32/64-safe) */
+    unsigned int total_hi;
+    unsigned int status;    /* out: 0 ok, 1 no source, 2 not running, 3 no memory */
+};
