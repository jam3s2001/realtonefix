+            ks_notif_size = p->bytes;
+            ks_notif_event = (unsigned long long)p->rate;     /* HANDLE in rate */
+            ks_notif_stride = p->channels ? p->channels : p->bytes / 8;
+            ks_notif_last = ks_cap_pumped;
+            ks_notif_pending = 1;
+            TRACE("ks notif armed: buf %p size %u event %p stride %u\n",
+                  ks_notif_buf, ks_notif_size,
+                  (void *)(UINT_PTR)ks_notif_event, ks_notif_stride);
+        }
+        else
+        {
+            WARN("ks notif arm REJECTED: buf %p bytes %u rate %x channels %u\n",
+                 p->buffer, p->bytes, p->rate, p->channels);
+            ks_notif_buf = NULL;
+            ks_notif_size = 0;
+            ks_notif_event = 0;
+            ks_notif_pending = 0;
+        }
+        pulse_unlock();
+        return STATUS_SUCCESS;
+    }
+
+    p->status = 1;
+    return STATUS_SUCCESS;
